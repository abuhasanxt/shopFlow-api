{
  "compilerOptions": {
    "module": "ESNext",  
    "moduleResolution": "node",   
    "target": "ES2023",  
    "types": [],                         
    // "rootDir": "./src",
    "outDir": "./dist",  
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0"
  },
 "include": ["src/**/*", "**/*"],
  "exclude": ["node_modules", "dist", "generated/prisma"]
}