<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Continue with Google</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8fafc, #eef2ff);
        font-family:
          Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial,
          sans-serif;
        color: #1f2937;
      }

      .container {
        width: 100%;
        max-width: 420px;
        padding: 20px;
      }

      .card {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 42px 32px;
        text-align: center;
        box-shadow:
          0 20px 50px rgba(15, 23, 42, 0.08),
          0 4px 12px rgba(15, 23, 42, 0.04);
      }

      .google-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 24px;
        border-radius: 50%;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
          0 8px 25px rgba(0, 0, 0, 0.08),
          0 0 0 1px #e5e7eb;
      }

      .google-icon svg {
        width: 32px;
        height: 32px;
      }

      h1 {
        font-size: 24px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 10px;
      }

      .description {
        font-size: 14px;
        line-height: 1.6;
        color: #6b7280;
        margin-bottom: 28px;
      }

      .loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #374151;
        font-size: 14px;
        font-weight: 500;
      }

      .spinner {
        width: 20px;
        height: 20px;
        border: 2px solid #e5e7eb;
        border-top-color: #4285f4;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      .error {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 12px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 13px;
        line-height: 1.5;
      }

      .retry-btn {
        display: none;
        margin: 20px auto 0;
        padding: 11px 22px;
        border: none;
        border-radius: 10px;
        background: #111827;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
      }

      .retry-btn:hover {
        background: #374151;
        transform: translateY(-1px);
      }

      .footer {
        margin-top: 24px;
        font-size: 12px;
        color: #9ca3af;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      @media (max-width: 480px) {
        .card {
          padding: 36px 24px;
        }

        h1 {
          font-size: 22px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="card">
        <!-- Google Icon -->
        <div class="google-icon">
          <svg viewBox="0 0 48 48">
            <path
              fill="#FFC107"
              d="M43.6 20.5H42V20H24v8h11.3C33.6 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.2 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.4-.4-3.5z"
            />

            <path
              fill="#FF3D00"
              d="M6.3 14.7l6.6 4.8C14.7 16 18.9 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.2 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"
            />

            <path
              fill="#4CAF50"
              d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.2C29.5 35.1 26.9 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.5 16.2 44 24 44z"
            />

            <path
              fill="#1976D2"
              d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.2-3.7 5.6-7 6.9l6.3 5.2C38.8 36.7 44 31 44 24c0-1.2-.1-2.4-.4-3.5z"
            />
          </svg>
        </div>

        <h1>Continue with Google</h1>

        <p class="description">
          Please wait while we securely redirect you to Google for
          authentication.
        </p>

        <!-- Loading -->
        <div class="loading" id="loading">
          <span class="spinner"></span>
          <span>Redirecting to Google...</span>
        </div>

        <!-- Error -->
        <div class="error" id="error"></div>

        <!-- Retry -->
        <button class="retry-btn" id="retryBtn" onclick="redirectToGoogle()">
          Try Again
        </button>

        <div class="footer">
          Secure authentication powered by Google
        </div>
      </div>
    </div>

    <script>
      async function redirectToGoogle() {
        const loading = document.getElementById("loading");
        const errorElement = document.getElementById("error");
        const retryBtn = document.getElementById("retryBtn");

        loading.style.display = "flex";
        errorElement.style.display = "none";
        retryBtn.style.display = "none";

        try {
          const response = await fetch(
            "<%betterAuthUrl %>/api/auth/sign-in/social",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              credentials: "include",
              body: JSON.stringify({
                provider: "google",
                callbackUrl: "<% callbackUrl %>",
              }),
            }
          );

          const data = await response.json();

          if (data.url) {
            window.location.href = data.url;
            return;
          }

          throw new Error(
            data.message || "Unable to start Google authentication."
          );
        } catch (error) {
          loading.style.display = "none";

          errorElement.textContent =
            error.message ||
            "Something went wrong while connecting to Google. Please try again.";

          errorElement.style.display = "block";
          retryBtn.style.display = "block";
        }
      }

      redirectToGoogle();
    </script>
  </body>
</html>