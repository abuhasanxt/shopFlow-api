model Product {
    id          String @id @default(uuid())
    name        String
    description String
    price       Int
    stock       Int
    categoryId  String
    imageUrl String
    isActive Boolean @default(true)

    category Category @relation(fields: [categoryId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([categoryId])
}
